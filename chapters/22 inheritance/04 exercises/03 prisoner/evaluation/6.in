>>> c2 = aiden.choice()
>>> c1, c2
('D', 'D')
>>> tessa.incscore(1)
>>> aiden.incscore(1)
>>> tessa.lastmove(c1, c2)
>>> aiden.lastmove(c2, c1)
>>> tessa.score
3
>>> aiden.score
9
>>> isinstance(tessa, Strategy) and isinstance(aiden, Strategy)
True

