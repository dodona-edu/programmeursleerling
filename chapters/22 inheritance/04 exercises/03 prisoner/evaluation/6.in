>>> aiden.lastmove(c2, c1)
>>> tessa.score
1
>>> aiden.score
7
>>> c1 = tessa.choice()
>>> c2 = aiden.choice()
>>> c1, c2
('D', 'D')
>>> tessa.incscore(1)
>>> aiden.incscore(1)
