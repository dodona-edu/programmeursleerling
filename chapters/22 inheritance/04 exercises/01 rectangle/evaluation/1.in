>>> square_01 = Square(2, 3, 4) # doctest: +NEWCONTEXT
>>> square_01 # doctest: +REPR
[(2,3),w=4,h=4]
>>> print(square_01) # doctest: +STDOUT
[(2,3),w=4,h=4]
>>> square_01.area()
16
>>> square_01.circumference()
16
>>> isinstance(square_01, Rectangle)
True

