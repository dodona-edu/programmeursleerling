>>> shapes = [Rectangle(1, 1, 6, 4), Square(0, 0, 3), Rectangle(-2, 5, 2, 9), Square(4, -1, 7)] # doctest: +NEWCONTEXT
>>> [shape.area() for shape in shapes]
[24, 9, 18, 49]
>>> [shape.circumference() for shape in shapes]
[20, 12, 22, 28]
>>> sum(shape.area() for shape in shapes)
100
>>> [isinstance(shape, Rectangle) for shape in shapes]
[True, True, True, True]

>>> shapes = [Square(-4, -4, 5), Rectangle(2, 2, 9, 1), Square(6, 6, 2), Rectangle(-8, 3, 4, 4)] # doctest: +NEWCONTEXT
>>> [shape.area() for shape in shapes]
[25, 9, 4, 16]
>>> [shape.circumference() for shape in shapes]
[20, 20, 8, 16]
>>> sum(shape.area() for shape in shapes)
54
>>> [isinstance(shape, Rectangle) for shape in shapes]
[True, True, True, True]

>>> shapes = [Rectangle(0, 0, 10, 10), Square(1, 1, 1), Rectangle(-5, -5, 3, 6), Square(5, 5, 5)] # doctest: +NEWCONTEXT
>>> [shape.area() for shape in shapes]
[100, 1, 18, 25]
>>> [shape.circumference() for shape in shapes]
[40, 4, 18, 20]
>>> sum(shape.area() for shape in shapes)
144
>>> [isinstance(shape, Rectangle) for shape in shapes]
[True, True, True, True]

