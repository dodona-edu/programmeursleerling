>>> rectangle_01 = Rectangle(1, 1, 8, 5) # doctest: +NEWCONTEXT
>>> rectangle_01 # doctest: +REPR
[(1,1),w=8,h=5]
>>> print(rectangle_01) # doctest: +STDOUT
[(1,1),w=8,h=5]
>>> rectangle_01.area()
40
>>> rectangle_01.circumference()
26
>>> isinstance(rectangle_01, Shape)
True

