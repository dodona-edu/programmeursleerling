>>> shapes = [Rectangle(1, 1, 6, 4), Circle(0, 0, 2), Square(-2, 5, 3), Circle(4, -1, 1)] # doctest: +NEWCONTEXT
>>> [round(shape.area(), 2) for shape in shapes]
[24, 12.57, 9, 3.14]
>>> [round(shape.circumference(), 2) for shape in shapes]
[20, 12.57, 12, 6.28]
>>> round(sum(shape.area() for shape in shapes), 2)
48.71
>>> [isinstance(shape, Shape) for shape in shapes]
[True, True, True, True]

>>> shapes = [Circle(-4, -4, 5), Rectangle(2, 2, 9, 1), Square(6, 6, 2), Circle(-8, 3, 3)] # doctest: +NEWCONTEXT
>>> [round(shape.area(), 2) for shape in shapes]
[78.54, 9, 4, 28.27]
>>> [round(shape.circumference(), 2) for shape in shapes]
[31.42, 20, 8, 18.85]
>>> round(sum(shape.area() for shape in shapes), 2)
119.81
>>> [isinstance(shape, Shape) for shape in shapes]
[True, True, True, True]

>>> shapes = [Square(0, 0, 10), Circle(1, 1, 4), Rectangle(-5, -5, 3, 6), Square(5, 5, 5)] # doctest: +NEWCONTEXT
>>> [round(shape.area(), 2) for shape in shapes]
[100, 50.27, 18, 25]
>>> [round(shape.circumference(), 2) for shape in shapes]
[40, 25.13, 18, 20]
>>> round(sum(shape.area() for shape in shapes), 2)
193.27
>>> [isinstance(shape, Shape) for shape in shapes]
[True, True, True, True]

