>>> compress('Hello, world!')
b'\x04\x81\xbb@,\xf0wI\xba\x02\x10'

>>> compress('')
b''

>>> compress('e')
b'\x10'

>>> compress(' ')
b'\xf0'

>>> compress('Q')
b'\x05\x10'

>>> compress('ee')
b'\x11'

>>> compress('eeeeeee')
b'\x11\x11\x11\x10'

>>> compress('etaoinshrdlcum ')
b'\x124Vx\x9a\xbc\xde\xf0'

>>> compress('the man in the moon')
b'(\x1f\xe3oV\xf2\x81\xfeD`'

>>> compress('QWERTY')
b'\x05\x10W\x04PR\x05@Y'

>>> compress('ABC 123')
b'\x04\x10B\x04?\x03\x102\x030'

>>> compress('How much wood would a woodchuck chuck\n')
b'\x04\x84\x07\x7f\xed\xc8\xf0wD\xaf\x07t\xdb\xaf?\x07tJ\xc8\xdc\x06\xbf\xc8\xdc\x06\xb0\n'

>>> compress('If a woodchuck could chuck wood?\n')
b'\x04\x90f\xf3\xf0wD\xac\x8d\xc0k\xfcM\xba\xfc\x8d\xc0k\xf0wD\xa0?\x00\xa0'

>>> compress('Ha! 42 & 0.5%\n')
b'\x04\x83\x02\x1f\x03@2\xf0&\xf00\x02\xe05\x02P\n'

>>> compress('Ca coute 12,50 EUR')
b'\x043\xfcM!\xf01\x03 ,\x03P0\xf0E\x05PR'

>>> compress('Ça coûte 12,50 ¤')
b'\x0cs\xfc@\xfb!\xf01\x03 ,\x03P0\xf0\xa4'

>>> compress('\x00\x01\x02')
b'\x00\x00\x01\x00 '

>>> compress('\x00\x01\x02\x03\x04\x05\x06\x07\x08\t\n\x0b\x0c\r\x0e\x0f')
