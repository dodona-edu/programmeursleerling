def opponent(player):

    """
    >>> opponent('X')
    'O'
    >>> opponent('O')
    'X'
    """

def display_board(board):

    """
    >>> display_board([['X', 'O', '.'], ['.', 'X', '.'], ['O', '.', 'X']])
      1 2 3
    1 X O .
    2 . X .
    3 O . X
    """

def winner(board):

