    >>> winner([['X', 'O', '.'], ['.', 'X', '.'], ['O', '.', 'X']])
    'X'
    >>> winner([['X', 'O', '.'], ['.', '.', '.'], ['O', '.', 'X']])
    """

def full(board):

    """
    >>> full([['X', 'O', 'X'], ['X', 'O', 'O'], ['O', 'X', 'X']])
    True
    >>> full([['X', 'O', '.'], ['.', 'X', '.'], ['O', '.', 'X']])
    False
    """

def place(board, player, row, column):

    """
    >>> board = [['.', '.', '.'], ['.', '.', '.'], ['.', '.', '.']]
    >>> place(board, 'X', 2, 2)
    True
    >>> board
    [['.', '.', '.'], ['.', 'X', '.'], ['.', '.', '.']]
