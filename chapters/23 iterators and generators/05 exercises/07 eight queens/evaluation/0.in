>>> sorted(queens(1))
[(0,)]

>>> sorted(queens(2))
[]

>>> sorted(queens(3))
[]

>>> sorted(queens(4))
[(1, 3, 0, 2), (2, 0, 3, 1)]

>>> sorted(queens(5))
[(0, 2, 4, 1, 3), (0, 3, 1, 4, 2), (1, 3, 0, 2, 4), (1, 4, 2, 0, 3), (2, 0, 3, 1, 4), (2, 4, 1, 3, 0), (3, 0, 2, 4, 1), (3, 1, 4, 2, 0), (4, 1, 3, 0, 2), (4, 2, 0, 3, 1)]

>>> sorted(queens(6))
[(1, 3, 5, 0, 2, 4), (2, 5, 1, 4, 0, 3), (3, 0, 4, 1, 5, 2), (4, 2, 0, 5, 3, 1)]

>>> len(list(queens(7)))
40

>>> len(list(queens(8)))
92

>>> len(list(queens(9)))
352

>>> len(list(queens()))
92

>>> min(queens(8))
(0, 4, 7, 5, 2, 6, 1, 3)

>>> max(queens(8))
(7, 3, 0, 2, 5, 1, 6, 4)

>>> (3, 1, 6, 2, 5, 7, 4, 0) in list(queens(8))
True

>>> g = queens(4)

>>> s = next(g)

>>> sorted(s) == sorted(range(4))
True

>>> s2 = next(g)

>>> sorted(s2) == sorted(range(4))
True

>>> s == s2
False

