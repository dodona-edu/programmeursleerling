def factorials(count=10):

    """
    >>> list(factorials())
    [1, 2, 6, 24, 120, 720, 5040, 40320, 362880, 3628800]
    >>> list(factorials(5))
    [1, 2, 6, 24, 120]
    >>> list(factorials(0))
    []
    """

    for n in range(1, count + 1):
        yield

if __name__ == '__main__':
    import doctest
    doctest.testmod()
